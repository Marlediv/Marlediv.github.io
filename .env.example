# Basis-URL der Website (ohne trailing slash). Wird für Metadata, Sitemap und robots.txt genutzt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub-Benutzername für die GitHub-Integration auf der Startseite.
NEXT_PUBLIC_GITHUB_USERNAME=

# Resend API-Key für den E-Mail-Versand des Kontaktformulars.
# Ohne gesetzten Key funktioniert das Formular im Entwicklungsmodus weiterhin
# (Nachrichten werden nur in der Server-Konsole protokolliert).
RESEND_API_KEY=

# Ziel-E-Mail-Adresse, an die Kontaktanfragen gesendet werden.
CONTACT_EMAIL=
