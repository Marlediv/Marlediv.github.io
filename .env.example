# Basis-URL der Website (ohne trailing slash). Wird für Canonical-URLs, Sitemap, robots.txt und Open Graph genutzt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: GitHub-Benutzername für die GitHub-Sektion der Startseite.
# Ohne Angabe gilt `githubUsername` aus content/site-config.ts.
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional: Token für die GitHub-API beim Build (hebt das Rate-Limit an). Niemals committen.
GITHUB_TOKEN=
